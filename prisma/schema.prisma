generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model News {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  content      String
  shortContent String?
  image        String?
  category     String
  language     String   @default("hi")
  isTrending   Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments Comment[]

  reporterId Int?
  reporter   Reporter? @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([reporterId])
}

model Reporter {
  id          Int      @id @default(autoincrement())
  name        String
  photo       String?
  designation String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news News[]

  @@index([name])
  @@index([isActive])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?  @unique
  googleId  String?  @unique
  mobile    String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationSubscriptions NotificationSubscription[]
  comments                  Comment[]
}

model NotificationSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  newsId    Int
  userId    Int?
  name      String
  content   String
  createdAt DateTime @default(now())

  news News  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newsId, createdAt])
  @@index([userId])
}

model Survey {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  image       String?
  type        String           @default("POLL")
  published   Boolean          @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  options     SurveyOption[]
  votes       SurveyVote[]
  responses   SurveyResponse[]

  @@index([published, createdAt])
}

model SurveyOption {
  id          Int          @id @default(autoincrement())
  surveyId    Int
  text        String
  description String?
  image       String?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  votes       SurveyVote[]

  @@index([surveyId, position])
}

model SurveyVote {
  id            Int          @id @default(autoincrement())
  surveyId      Int
  optionId      Int
  voterKey      String
  name          String?
  comment       String?
  commentHidden Boolean      @default(false)
  createdAt     DateTime     @default(now())
  survey        Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  option        SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([surveyId, voterKey])
  @@index([surveyId, optionId])
}

model SurveyResponse {
  id        Int      @id @default(autoincrement())
  surveyId  Int
  name      String
  content   String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, createdAt])
}
